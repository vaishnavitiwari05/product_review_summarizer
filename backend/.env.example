# --- LLM (any API provider; wired up in Phase 7) ---
# LLM_PROVIDER: anthropic | openai  ("openai" also works for any OpenAI-compatible server via LLM_BASE_URL)
LLM_PROVIDER=openai
LLM_API_KEY= 
# anthropic defaults to claude-sonnet-5-5 if empty; for openai you must set a model name
LLM_MODEL=openai/gpt-oss-20b
# optional: custom API base URL (e.g. http://localhost:11434/v1 for a local OpenAI-compatible server)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# true = use built-in mock summarizer (no API key needed)
USE_MOCK_LLM=true

# --- Database ---
# Dev default (SQLite):
DATABASE_URL=sqlite:///./reviews.db
# PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reviews

# --- App ---
MAX_UPLOAD_MB=25
# comma-separated list of browser origins allowed to call the API (the frontend's address)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Sentiment (Phase 4) ---
# auto = try the Hugging Face model, fall back to VADER if it cannot be loaded
# transformer = require the model (error if unavailable) | vader = lightweight rule-based
SENTIMENT_BACKEND=auto
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
SENTIMENT_BATCH_SIZE=32

# --- Opinion grouping (Phase 6) ---
# auto = try sentence-transformers, fall back to TF-IDF | sbert = require it | tfidf = lightweight
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- API (Phase 9) ---
# Path to the demo CSV loaded by POST /sample (defaults to ../data/sample_reviews.csv)
# SAMPLE_DATA_PATH=
